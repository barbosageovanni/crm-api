{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true, // Manter se for necessário para Node.js
    "lib": ["ES2023"], // Apenas ES2023 para backend, DOM/DOM.Iterable são para navegador
    "module": "CommonJS", // Essencial para CommonJS
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"], // Removi "./src/vite-env.d.ts" se é backend puro
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Configurações para resolução de módulos no Node.js
    "moduleResolution": "node", // Usar 'node' com CommonJS
    "allowImportingTsExtensions": false, // Não necessário para CommonJS
    "resolveJsonModule": true,
    "isolatedModules": false, // Não é comum para APIs Node.js puras
    "noEmit": true, // Manter se você usa ts-node e não gera JS
    // "jsx": "react-jsx", // Remover se for apenas backend

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/contexts/*": ["./src/contexts/*"],
      "@/features/*": ["./src/features/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/types/*": ["./src/types/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/services/*": ["./src/services/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/dtos/*": ["src/dtos/*"]
    }
  },
  "include": ["src/**/*.ts"], // Inclua apenas os arquivos .ts da sua API
  "exclude": ["node_modules", "dist"]
}