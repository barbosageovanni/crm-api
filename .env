DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/crm-api"
PORT=8080

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ambiente de execução
NODE_ENV=development

# URLs permitidas para CORS
ALLOWED_ORIGINS=http://localhost:4001,http://localhost:5173

# ... outras variáveis ...
JWT_SECRET=a3eba21064d4b525ae3c43df6c7fa5caa2d4eda7c57aa8cbb72783a25dfa408c
JWT_EXPIRES_IN=86400 # 24 horas em segundos

# .env.example - Arquivo de exemplo para variáveis de ambiente do backend

# URL do frontend para CORS
FRONTEND_URL="http://localhost:5173"

# Configurações de email (se necessário)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Configurações de logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configurações de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações de segurança
BCRYPT_ROUNDS=12
HELMET_CSP_ENABLED=true
